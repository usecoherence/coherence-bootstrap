#!/usr/bin/env bash
# Dispatch one catalog AC id to world/ac/<AC_ID>.sh (L0 harness).
# Usage: run-ac <AC_ID>
# Env: optional COHERENCE_CORE_DB_BIN, optional COHERENCE_WORLD_RUN_ID
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORLD_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT="$(cd "$WORLD_DIR/../../.." && pwd)"

AC_ID="${1:?usage: run-ac <AC_ID>}"
AC_SCRIPT="$WORLD_DIR/ac/${AC_ID}.sh"
if [[ ! -f "$AC_SCRIPT" ]]; then
  echo "run-ac: no handler for ${AC_ID} (${AC_SCRIPT} missing)" >&2
  exit 2
fi

RUN_ID="${COHERENCE_WORLD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
EVIDENCE_DIR="$WORLD_DIR/evidence/$RUN_ID/$AC_ID"
mkdir -p "$EVIDENCE_DIR"

if [[ -n "${COHERENCE_CORE_DB_BIN:-}" ]]; then
  :
elif [[ -x "$ROOT/target/debug/coherence-core-db" ]]; then
  export COHERENCE_CORE_DB_BIN="$ROOT/target/debug/coherence-core-db"
else
  echo "run-ac: set COHERENCE_CORE_DB_BIN or build: (cd \"$ROOT\" && cargo build -p coherence-core-db)" >&2
  exit 2
fi

export ROOT WORLD_DIR EVIDENCE_DIR COHERENCE_WORLD_RUN_ID="$RUN_ID"
echo "run-ac: AC_ID=$AC_ID RUN_ID=$RUN_ID EVIDENCE_DIR=$EVIDENCE_DIR"
bash "$AC_SCRIPT"
echo "run-ac: OK $AC_ID"
