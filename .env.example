# CodeScene Cloud/open-source projects usually use https://codescene.io.
# Self-hosted Enterprise users should set their own CodeScene base URL here.
CS_ONPREM_URL=https://codescene.io
CS_ACCESS_TOKEN=changeme

# Backward-compatible local alias used by scripts/codescene-env.
# Prefer CS_ACCESS_TOKEN for new setups.
CODESCENE_PAT=changeme
