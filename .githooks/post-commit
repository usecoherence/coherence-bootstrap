#!/usr/bin/env bash
# Incremental build so ./target/debug/coherence-core-db matches the tree you
# just committed. Does not update a copy on PATH (use make install-local-force).
set -euo pipefail
if [[ -n "${GIT_HOOK_SKIP_COHERENCE_BUILD:-}" ]]; then
  exit 0
fi
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0
cd "$root"
[[ -f Cargo.toml && -d crates/coherence-core-db ]] || exit 0
if cargo build -p coherence-core-db --locked -q; then
  :
else
  echo "post-commit: cargo build -p coherence-core-db failed (debug binary may be stale)." >&2
fi
exit 0
