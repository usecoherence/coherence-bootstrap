#!/usr/bin/env bash
set -euo pipefail

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

if [ -z "${CS_ACCESS_TOKEN:-}" ] && [ -n "${CODESCENE_PAT:-}" ]; then
  export CS_ACCESS_TOKEN="${CODESCENE_PAT}"
fi

missing=()
if [ -z "${CS_ONPREM_URL:-}" ]; then
  missing+=(CS_ONPREM_URL)
fi
if [ -z "${CS_ACCESS_TOKEN:-}" ]; then
  missing+=(CS_ACCESS_TOKEN)
fi

if [ "${#missing[@]}" -gt 0 ]; then
  printf 'codescene: missing required environment variable(s): %s\n' "${missing[*]}" >&2
  printf 'codescene: copy .env.example to .env and fill CodeScene URL/token.\n' >&2
  exit 2
fi

exec "$@"
