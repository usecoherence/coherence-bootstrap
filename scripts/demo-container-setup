#!/usr/bin/env bash
set -euo pipefail

bootstrap_export="/opt/coherence-bootstrap/bootstrap-specs.jsonl"
bootstrap_project="${COHERENCE_BOOTSTRAP_SPECS_DIR:-/root/git/coherence-bootstrap}"
demo_project="${COHERENCE_DEMO_PROJECT_DIR:-/root/git/demo}"

mkdir -p "${bootstrap_project}" "${demo_project}"

(
  cd "${bootstrap_project}"
  COHERENCE_BOOTSTRAP_SLUG=coherence_specs coherence-demo-init
  coherence-bootstrap db import-jsonl \
    --env dev \
    --in "${bootstrap_export}" \
    --confirm
)

(
  cd "${demo_project}"
  COHERENCE_BOOTSTRAP_SLUG="${COHERENCE_BOOTSTRAP_SLUG:-demo}" coherence-demo-init
)

cat <<EOF
coherence-demo-setup: ready

Demo projects:
  ${bootstrap_project}  imported bootstrap Coherence specs
  ${demo_project}       empty/minimal project for your own demo specs

Try:
  cd ${bootstrap_project} && coherence-bootstrap spec list
  cd ${demo_project} && coherence-bootstrap spec list
  coherence-bootstrap tui
EOF
