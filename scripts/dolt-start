#!/usr/bin/env bash
set -euo pipefail

if ! command -v dolt >/dev/null 2>&1; then
  echo "dolt-start: dolt is missing" >&2
  exit 1
fi

echo "dolt-start: repo-local Coherence DB"
echo "  owner: this repository"
echo "  boundary: do not write dependency/vendor repos' Dolt DBs"

if [ ! -d .dolt ]; then
  author_name="${DOLT_AUTHOR_NAME:-}"
  author_email="${DOLT_AUTHOR_EMAIL:-}"
  identity_source="env"

  if [ -z "$author_name" ]; then
    author_name="$(git config user.name 2>/dev/null || true)"
  fi
  if [ -z "$author_email" ]; then
    author_email="$(git config user.email 2>/dev/null || true)"
  fi
  if [ -n "$author_name" ] && [ -n "$author_email" ]; then
    identity_source="git-config"
  else
    author_name="${author_name:-Coherence Local Dev}"
    author_email="${author_email:-coherence-local-dev@localhost.invalid}"
    identity_source="fallback"
  fi

  echo "dolt init identity"
  echo "  source: $identity_source"
  echo "  name:   $author_name"
  echo "  email:  $author_email"
  dolt init --name "$author_name" --email "$author_email"
fi

mkdir -p .coherence/run
if [ -f .coherence/run/dolt.pid ] && kill -0 "$(cat .coherence/run/dolt.pid)" 2>/dev/null; then
  echo "dolt sql-server already running: pid $(cat .coherence/run/dolt.pid)"
  exit 0
fi

port="${DOLT_PORT:-3306}"
socket=".dolt/dolt.sock"

# Dolt socket support exists, but beads/socket-only support may vary by version.
# Keep TCP fallback enabled until the full integration is verified.
nohup dolt sql-server --host 127.0.0.1 --port "$port" --socket "$socket" \
  > .coherence/run/dolt.log 2>&1 &
echo "$!" > .coherence/run/dolt.pid

echo "dolt sql-server starting"
echo "  pid:    $(cat .coherence/run/dolt.pid)"
echo "  host:   127.0.0.1"
echo "  port:   $port"
echo "  socket: $socket"
echo "  log:    .coherence/run/dolt.log"
