#!/usr/bin/env bash
set -euo pipefail

if ! command -v dolt >/dev/null 2>&1; then
  echo "migrate: dolt is missing" >&2
  exit 1
fi

echo "migrate: scaffold migrations for this repo-local Coherence DB"
echo "migrate: core-db owns shared conventions; this template does not own final DB architecture"

if [ ! -d .dolt ]; then
  echo "migrate: .dolt missing; run make tool dolt-start or dolt init first" >&2
  exit 1
fi

for migration in .coherence/migrations/*.sql; do
  echo "applying $migration"
  dolt sql < "$migration"
done

echo "migrate: ok"
