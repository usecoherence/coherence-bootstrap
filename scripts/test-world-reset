#!/usr/bin/env bash
# Drop repo-local Dolt state after ./scripts/dolt-stop. Only when COHERENCE_DB_PROFILE=test
# (same gate as mutating smoke paths) so canonical/default sessions do not wipe .dolt by accident.
set -euo pipefail

raw="${COHERENCE_DB_PROFILE:-}"
norm="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
if [ "$norm" != "test" ]; then
  echo "test-world-reset: blocked: refusing to remove repo .dolt — isolated test-world profile required (ADR-0004)." >&2
  if [ -n "$raw" ]; then
    echo "  Cause: COHERENCE_DB_PROFILE is $(printf '%q' "$raw") — need test (non-test profiles are refused)." >&2
  else
    echo "  Cause: COHERENCE_DB_PROFILE is unset — canonical/default session; need COHERENCE_DB_PROFILE=test." >&2
  fi
  cat >&2 <<'EOF'
  Next targets (repository root):
    • Workspace tests — make test-isolated  or  make tool run
    • Mutating smoke (writes fixtures) — make smoke
    • This teardown — make test-world-reset  (Makefile sets COHERENCE_DB_PROFILE=test)
    • Optional: skip make test-world-reset after a failed run if you need to inspect .dolt state
EOF
  echo "  Fix: export COHERENCE_DB_PROFILE=test  or  run from repo root: make test-world-reset" >&2
  exit 1
fi

"$(dirname "$0")/dolt-stop" || true
rm -rf .dolt
rm -f .coherence/run/dolt.pid
echo "test-world-reset: removed repo-local .dolt; next: make tool dolt-start, then migrate/smoke via isolated targets"
